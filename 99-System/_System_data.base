filters:
  and:
    - file.folder.contains("99-System") or type == "system"
properties:
  title:
    displayName: System note
  type:
    displayName: Type
  status:
    displayName: Status
  created:
    displayName: Created
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: System — Missing metadata
    filters:
      or:
        - "!status"
        - "!created"
        - "!type"
    order:
      - file.name
