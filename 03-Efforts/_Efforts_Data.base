filters:
  and:
    - file.folder.startsWith("03-Efforts")
    - '!file.name.startswith("+")'
    - '!file.name.startswith("03")'
    - '!file.name.contains("Template")'
formulas:
  Days Stale: (today() - file.mtime).days.round() + " days ago"
  Due In: (note["due"] - today()).days.round() + " days"
  Linked Atoms: file.links.filter(value.asFile().properties.type == "atomic").length
  Linked Sources: file.links.filter(value.asFile().properties.type == "source").length
views:
  - type: table
    name: All Efforts
    order:
      - file.name
      - rank
      - file.folder
      - status
      - formula.Due In
      - formula.Days Stale
      - formula.Linked Atoms
      - formula.Linked Sources
    sort:
      - property: file.folder
        direction: ASC
      - property: rank
        direction: DESC
    columnSize:
      file.name: 318
      file.folder: 229
  - type: table
    name: Active Projects
    filters:
      and:
        - file.inFolder("03-Efforts/On")
    order:
      - file.name
      - rank
      - status
      - formula.Due In
      - formula.Days Stale
      - formula.Linked Atoms
      - formula.Linked Sources
      - next_actions
    sort:
      - property: rank
        direction: DESC
  - type: table
    name: Simmering Projects
    filters:
      and:
        - file.inFolder("03-Efforts/Simmering")
    order:
      - file.name
      - rank
      - up
      - related
      - file.links
    sort:
      - property: rank
        direction: DESC
  - type: table
    name: Sleeping Projects
    filters:
      and:
        - file.inFolder("03-Efforts/Sleeping")
    order:
      - file.name
      - rank
      - up
      - related
      - file.links
    sort:
      - property: rank
        direction: DESC
  - type: table
    name: Recently Edited Efforts
    order:
      - file.name
      - rank
      - formula.Days Stale
      - formula.Due In
      - formula.Linked Atoms
      - formula.Linked Sources
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 318
  - type: table
    name: Needs Attention
    filters:
      and:
        - status == "🔄active"
    order:
      - file.name
      - formula.Days Stale
      - formula.Due In
      - next_actions
      - priority
    sort:
      - property: file.mtime
        direction: ASC
