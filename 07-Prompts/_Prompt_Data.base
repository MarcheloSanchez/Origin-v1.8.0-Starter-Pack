filters:
  and:
    - file.folder.contains("07-Prompts")
    - not file.folder.contains("Archive")
    - not file.folder.contains("01-Docs")
views:
  - type: table
    name: All Prompts
    order:
      - file.name
      - file.folder
      - status
      - prompt_category
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Workbench
    filters:
      and:
        - file.folder.contains("Workbench")
    order:
      - file.name
      - prompt_category
      - prompt_type
      - difficulty
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Reference
    filters:
      and:
        - file.folder.contains("Reference")
    order:
      - file.name
      - prompt_category
      - status
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Inbox
    filters:
      and:
        - file.folder.contains("Inbox")
    order:
      - file.name
      - prompt_category
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Recently Edited
    sort:
      - property: file.mtime
        direction: DESC
    order:
      - file.name
      - file.folder
      - prompt_category
      - file.mtime
