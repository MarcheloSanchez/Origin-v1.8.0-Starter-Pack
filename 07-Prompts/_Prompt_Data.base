filters:
  and:
    - file.folder.contains("07-Prompts")
    - '!file.folder.contains("Archive")'
    - '!file.folder.contains("01-Docs")'
views:
  - type: table
    name: All Prompts
    order:
      - file.name
      - file.folder
      - status
      - prompt_category
      - prompt_type
      - difficulty
      - summary
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Workbench
    filters:
      and:
        - file.folder.contains("Workbench")
    order:
      - file.name
      - prompt_category
      - prompt_type
      - difficulty
      - summary
      - language
      - version
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Reference
    filters:
      and:
        - file.folder.contains("Reference")
    order:
      - file.name
      - status
      - prompt_category
      - prompt_type
      - difficulty
      - summary
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Inbox
    filters:
      and:
        - file.folder.contains("Inbox")
    order:
      - file.name
      - prompt_category
      - prompt_type
      - difficulty
      - summary
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Fun
    filters:
      and:
        - file.folder.contains("Fun")
    order:
      - file.name
      - prompt_category
      - prompt_type
      - summary
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Recently Edited
    order:
      - file.name
      - file.folder
      - prompt_category
      - prompt_type
      - summary
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
