filters:
  and:
    - file.inFolder("05-Calendar")
views:
  - type: table
    name: Calendar overview
    order:
      - file.name
      - file.tags
      - status
      - sleep
      - energy
      - file.mtime
  - type: table
    name: Calendar Recently Edited
    order:
      - file.name
      - file.tags
      - status
      - sleep
      - energy
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
