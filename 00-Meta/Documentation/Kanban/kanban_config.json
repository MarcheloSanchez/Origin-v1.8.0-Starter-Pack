{
  "universal_kanban_settings": {
    "plugin_settings": {
      "enable_card_checkboxes": true,
      "new_line_trigger": "Shift+Enter",
      "prepend_new_cards": true,
      "show_card_counts": true,
      "hide_tags_in_titles": false,
      "date_format": "YYYY-MM-DD",
      "time_format": "HH:mm",
      "link_dates_to_daily_notes": true,
      "show_relative_dates": true,
      "max_archive_size": 100,
      "auto_archive_after_days": 30
    },
    "board_template": {
      "default_columns": [
        {
          "name": "Inbox",
          "wip_limit": 10,
          "color": "#ff6b6b"
        },
        {
          "name": "To Do",
          "wip_limit": 8,
          "color": "#4ecdc4"
        },
        {
          "name": "In Progress",
          "wip_limit": 3,
          "color": "#45b7d1"
        },
        {
          "name": "Review",
          "wip_limit": 5,
          "color": "#f9ca24"
        },
        {
          "name": "Done",
          "wip_limit": null,
          "color": "#6c5ce7"
        }
      ]
    },
    "tag_system": {
      "priority_tags": {
        "urgent": {
          "color": "#ff3838",
          "description": "Immediate attention required"
        },
        "high-priority": {
          "color": "#ff4757",
          "description": "High importance"
        },
        "medium-priority": {
          "color": "#ffa502",
          "description": "Medium importance"
        },
        "low-priority": {
          "color": "#2ed573",
          "description": "Low importance"
        }
      },
      "category_tags": {
        "project": {
          "color": "#3742fa",
          "description": "Project-related tasks"
        },
        "personal": {
          "color": "#2f3542",
          "description": "Personal tasks"
        },
        "work": {
          "color": "#1e3799",
          "description": "Work-related tasks"
        },
        "review": {
          "color": "#8c7ae6",
          "description": "Review tasks"
        }
      },
      "status_tags": {
        "blocked": {
          "color": "#747d8c",
          "description": "Blocked or waiting"
        },
        "waiting": {
          "color": "#ffd32a",
          "description": "Waiting for input"
        },
        "bug": {
          "color": "#ff4757",
          "description": "Bug reports"
        },
        "feature": {
          "color": "#5352ed",
          "description": "Feature requests"
        },
        "research": {
          "color": "#40739e",
          "description": "Research tasks"
        },
        "meeting": {
          "color": "#487eb0",
          "description": "Meeting-related"
        },
        "documentation": {
          "color": "#44bd32",
          "description": "Documentation tasks"
        }
      }
    },
    "keyboard_shortcuts": {
      "new_card": "Ctrl+N",
      "move_card_right": "Ctrl+Right Arrow",
      "move_card_left": "Ctrl+Left Arrow",
      "edit_card": "Enter",
      "complete_card": "Ctrl+Space",
      "archive_card": "Ctrl+Shift+A",
      "focus_search": "Ctrl+F"
    },
    "card_templates": {
      "default": {
        "title": "{{title}}",
        "status": "{{status}}",
        "priority": "{{priority}}",
        "due_date": "{{due}}",
        "tags": "{{tags}}",
        "notes": "{{notes}}"
      },
      "project": {
        "title": "{{title}}",
        "status": "{{status}}",
        "priority": "{{priority}}",
        "assignee": "{{assignee}}",
        "estimated_hours": "{{hours}}",
        "due_date": "{{due}}",
        "acceptance_criteria": "{{criteria}}",
        "tags": "{{tags}}"
      },
      "research": {
        "title": "{{title}}",
        "research_question": "{{question}}",
        "key_findings": "{{findings}}",
        "references": "{{references}}",
        "status": "{{status}}",
        "tags": "{{tags}}"
      },
      "meeting": {
        "title": "{{title}}",
        "agenda": "{{agenda}}",
        "attendees": "{{attendees}}",
        "action_items": "{{actions}}",
        "date": "{{date}}",
        "tags": "{{tags}}"
      }
    },
    "mobile_settings": {
      "column_width": "250px",
      "touch_gestures": true,
      "reduced_metadata": true,
      "simplified_view": true,
      "auto_hide_sidebar": true
    }
  }
}