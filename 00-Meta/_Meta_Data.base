filters:
  and:
    - file.folder.startsWith("00-Meta")
views:
  - type: table
    name: All Meta
    order:
      - file.name
      - status
      - type
      - up
      - tags
      - file.mtime
    sort: []
  - type: table
    name: All Meta 🔄active
    filters:
      and:
        - status == "🔄active"
    order:
      - file.name
      - type
      - up
      - tags
      - file.mtime
    sort:
      - property: status
        direction: ASC
    limit: 10
