filters:
  and:
    - and:
        - file.folder.contains("02-Dots/100-Atomics")
        - and:
            - '!file.name.contains("base")'
formulas:
  stage: maturity
  last_touch: file.mtime.date().toString()
  Outlinks: file.links.length
  Backlinks: file.backlinks.length
  Days Stable: (today() - file.mtime).days.round()
  Promote?: |-
    if(maturity == "📤seed",
      if(file.links.length >= 2 && file.backlinks.length >= 1, "✅ → seedling", "❌"),
      if(maturity == "🌱seedling",
        if(file.links.length >= 5 && file.backlinks.length >= 2, "✅ → sapling", "❌"),
        if(maturity == "🪴sapling",
          if(file.links.length >= 10 && file.backlinks.length >= 5 && (today() - file.mtime).days.round() >= 30, "✅ → evergreen", "❌"),
          if(maturity == "🌲evergreen",
            if(file.links.length >= 15 && file.backlinks.length >= 10 && (today() - file.mtime).days.round() >= 60, "✅ → fruit", "❌"),
            "🍓"
          )
        )
      )
    )
properties:
  title:
    displayName: Atomic
  stage:
    displayName: Maturity
  tags:
    displayName: Tags
  related:
    displayName: Related
  file.mtime:
    displayName: Modified
  formula.last_touch:
    displayName: Last edited
views:
  - type: cards
    name: Atomics — Cards
    limit: 100
  - type: table
    name: Atomics — Table
    order:
      - maturity
      - file.mtime
  - type: table
    name: All Atomics
  - type: table
    name: Maturity Pipeline
    order:
      - file.name
      - maturity
      - formula.Outlinks
      - formula.Backlinks
      - formula.Days Stable
      - formula.Promote?
    sort:
      - property: formula.Promote?
        direction: DESC
      - property: maturity
        direction: ASC
  - type: table
    name: Ready to Promote
    order:
      - file.name
      - maturity
      - formula.Promote?
      - formula.Outlinks
      - formula.Backlinks
      - formula.Days Stable
    sort:
      - property: maturity
        direction: ASC
